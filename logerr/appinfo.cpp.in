#include <sys/auxv.h>
#else
#define getauxval(...) 0ULL
#endif
#if __has_include(<winsock.h>)
#include <winsock.h>
#endif
#if __has_include(<libloaderapi.h>)
#include <libloaderapi.h>
#else
#define GetModuleFileNameA(...) 0UL
#endif
#endif

using namespace std;

//--------------------------------------------------------------------------------------------------
// CONSTANT STRINGS
//--------------------------------------------------------------------------------------------------

namespace APPINFO::detail
{
	string environmentVariable(const char* name)
	{
		if (const char* value = std::getenv(name))
			return value;
		return {};
	}

	string normalizedPath(string path)
	{
		std::replace(path.begin(), path.end(), '\\', '/');
		return path;
	}

	// Application Info
	string       name("unset_name");
	const string organization("@APPLICATION_ORGANIZATION@");
	const string organizationDomain(git::origin);
	const string version(git::tag + '.' + git::commitShort + git::dirtyString);

	// Build Host Info
	const string buildHostname("@BUILD_HOSTNAME@");
